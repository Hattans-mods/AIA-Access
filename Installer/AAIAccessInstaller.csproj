<Project Sdk="Microsoft.NET.Sdk">
  <!-- The installer runs on the .NET Framework 4.8 that comes with Windows 10 and 11, so players need nothing extra.
       Build: dotnet build Installer/AAIAccessInstaller.csproj -c Release  (needs internet once, for the reference package) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>AAIAccess-Installer</AssemblyName>
    <RootNamespace>AAIAccessInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>AAI Access Installer</Product>
    <Company>Hattans-mods</Company>
    <Copyright>© Hattans-mods, MIT licence</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
